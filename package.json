{
  "name": "prueba-scrap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix=nest-api && npm run build --prefix=angular-app",
    "start": "npm run start:prod --prefix=nest-api",
    "dev": "concurrently \"npm run start:dev --prefix=nest-api\" \"npm run start --prefix=angular-app\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vercel/node": "^5.6.23",
    "concurrently": "^8.0.0"
  }
}
