{
  "version": 2,
  "public": "angular-app/dist/angular-app/browser",
  "functions": {
    "api/server.ts": {
      "@vercel/node": {}
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
