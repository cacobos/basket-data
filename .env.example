# Database
DATABASE_URL=postgresql://user:password@localhost:5432/prueba_scrap_db

# Environment
NODE_ENV=development

# API (cuando se despliegue en Vercel, se generará automáticamente)
API_URL=http://localhost:3000

# Frontend (cuando se despliegue en Vercel)
FRONTEND_URL=http://localhost:4200

# Firebase Auth (frontend runtime config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Backend API URL for frontend runtime config
API_BASE_URL=
